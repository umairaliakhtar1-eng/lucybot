# Meta App settings - Facebook/Instagram/WhatsApp are Meta-owned. Telegram
# uses its own bot token (from BotFather).
#
# NOTE: You can also add these tokens from the dashboard "Channels" page
# (stored encrypted in DB). DB connection takes priority; .env values are
# fallback. Both can be used together.

# Facebook / Instagram: Graph API  ->  Page Access Token
# WhatsApp:              Cloud API  ->  WABA token + phone number id

# Webhook
VERIFY_TOKEN=boss_lucy_verify_token
# Meta App ID + App Secret (app-level webhook subscribe ke liye zaroori)
APP_ID=
APP_SECRET=your_app_secret

# Facebook Messenger (Page Access Token, starts with EAAG...)
PAGE_ACCESS_TOKEN=

# Instagram (permanent IG token from Graph API Explorer)
IG_ACCESS_TOKEN=

# WhatsApp Business Cloud API
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Optional: used to ignore echoes from your own number. Use + format, e.g. 15551234567
WA_OWN_NUMBER=

# Telegram (optional .env fallback - adding via UI Channels page is preferred)
# Get bot token from BotFather. Account ID is optional (auto-detected via getMe).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCOUNT_ID=

# App
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
DB_FILE=data/boss-lucy.db

# Database backup — consistent snapshot on each server start (WAL-safe).
# BACKUP_KEEP keeps only the latest N backups.
BACKUP_DIR=data/backups
BACKUP_KEEP=10

# Default admin agent (created automatically on first run)
ADMIN_EMAIL=admin@bosslucy.local
ADMIN_PASSWORD=ChangeMe-Admin-123
ADMIN_NAME=Admin

# Owner account (created automatically on first run). Only owner can
# create/promote/demote admins. Change password after first login.
OWNER_EMAIL=Lucy@zeus.com
OWNER_PASSWORD=Zeus-9115
OWNER_NAME=Boss Lucy

# Cloudflare R2 (S3-compatible) - OPTIONAL for local dev, MANDATORY for Render
# Render ka filesystem ephemeral hai. Bina R2 ke uploaded images/documents
# har redeploy/restart pe delete ho jayenge.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME
# Public bucket ya custom public path ke liye. Agar empty hai to R2 endpoint URL use hoga.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev